# ---------- LLM (any OpenAI-compatible endpoint) ----------
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=anthropic/claude-sonnet-4
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5-coder:14b   (no key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---------- Agent ----------
# AGENT_WORKDIR=/path/to/project        (default: where you launch it; in Docker: /workspace)
AGENT_APPROVAL=auto                      # auto | ask | deny  (dangerous commands)
AGENT_MAX_ITERATIONS=40
# AGENT_DATA_DIR=./data                  (sessions, memory, jobs)

# ---------- Web UI / API ----------
PORT=8787
HOST=0.0.0.0
# AGENT_WEB_TOKEN=change-me              (bearer token for /api/* if exposed publicly)

# ---------- Telegram (long polling; no public URL needed) ----------
# 1) @BotFather → /newbot → copy token   2) message your bot; it replies with your chat id
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------- WhatsApp (Meta Cloud API; needs a public HTTPS URL to /webhooks/whatsapp) ----------
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_VERIFY_TOKEN=any-string-you-choose
# WHATSAPP_APP_SECRET=...                 (optional, enables signature verification)
# WHATSAPP_ALLOWED_NUMBERS=2348012345678

# ---------- Voice ----------
# STT uses <STT_BASE_URL>/audio/transcriptions (defaults to the LLM endpoint + whisper-1).
# Groq: STT_BASE_URL=https://api.groq.com/openai/v1  STT_API_KEY=gsk_...  STT_MODEL=whisper-large-v3
# STT_BASE_URL=
# STT_API_KEY=
# STT_MODEL=whisper-1
# TTS uses <TTS_BASE_URL>/audio/speech (OpenAI tts-1); the Web UI falls back to browser speech.
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
